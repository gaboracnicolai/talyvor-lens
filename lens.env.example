# lens.env — forwarded WHOLESALE into the lens container (docker-compose.yaml `env_file:`).
#
# ⚠ THIS FILE IS NOT `.env`, AND THE DIFFERENCE MATTERS.
#   .env      = the compose PROJECT file. It feeds ${VAR} substitution for every service, and on the
#               deployed box it also carries TRACK_GATEWAY_AUTH_SECRET / DOCS_GATEWAY_AUTH_SECRET /
#               DOCS_WORKSPACE_ID for deploy/track-docs.compose.yaml. Lens has no use for those and
#               must not receive them — that is why Lens does not forward .env.
#   lens.env  = LENS_* only, forwarded to the lens container and nowhere else.
#
# Copy to `lens.env` and set what you need. Every variable is OPTIONAL: unset keeps the documented
# default. The file itself is optional too (`required: false`), so a deployment without it boots
# exactly as before.
#
# Anything internal/config reads can go here — you no longer have to add it to docker-compose.yaml
# first. That enumeration is what made 65 variables MUTE: settable in .env, never reaching the
# process, with no difference from the inside between "unset" and "not forwarded".

# ─────────────────────────────────────────────────────────────────────────────────────────────
# ⚠ MONEY-PATH CONTROLS — the reason this file exists.
#
# These were mute. A mute money control is a SAFETY VALVE WELDED SHUT: it is not that the default
# is wrong, it is that you cannot CHANGE it. The mint caps are the sharpest case — a cap exists for
# the moment something is minting too fast, which is exactly the moment you would need to tighten
# it and could not.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Settlement fail-closed. Default FALSE — so before this file you could not turn the protection ON.
# LENS_SETTLEMENT_FAIL_CLOSED_ENABLED=true

# The billing-redesign rollback path. Default TRUE — so before this file you could not turn it OFF,
# which means the documented rollback did not exist.
# LENS_LXC_RESERVATION_ENABLED=false
# LENS_LXC_RESERVATION_MAX_OUTPUT_TOKENS=4096

# The immediate-debit fallback (runs whenever the reservation seam is inactive). Default TRUE.
# LENS_LXC_AGENT_ALLOCATION_ENABLED=false

# Mint caps and royalty share. Tighten these when a mint is running hot.
# LENS_POOL_MINT_CAP_PER_ENTRY=
# LENS_POOL_MINT_CAP_PER_PAIR=
# LENS_POOL_MINT_CAP_WINDOW=
# LENS_POOL_ROYALTY_SHARE=
# LENS_POOL_HOLDBACK_WINDOW=
# LENS_DISTILL_MINT_CAP_PER_CONTENT=
# LENS_DISTILL_MINT_CAP_PER_PAIR=
# LENS_DISTILL_MINT_CAP_WINDOW=
# LENS_MINT_RATE_CAP_LENS_24H=

# Price ceiling used by the price-aware routing strategy. Must be > 0 when set.
# LENS_GATEWAY_PRICE_CEILING=

# ─────────────────────────────────────────────────────────────────────────────────────────────
# OPERATOR ALERTING
# ⚠ Leave the operator webhook UNSET until a receiver exists. Nothing accepts its `catalog_drift`
# payload today; Track's /v1/lens/webhook 200s unknown types, which this client reads as DELIVERED.
# ─────────────────────────────────────────────────────────────────────────────────────────────
# LENS_TRACK_WEBHOOK_URL=http://track:3000/v1/lens/webhook
# LENS_TRACK_WEBHOOK_SECRET=          # must equal Track's TRACK_LENS_WEBHOOK_SECRET
# LENS_OPERATOR_ALERT_WEBHOOK_URL=
# LENS_OPERATOR_ALERT_WEBHOOK_SECRET=

# Add a model the catalog does not know, with its PUBLISHED rate, without a rebuild.
# LENS_MODEL_CATALOG_OVERRIDES=

# ─────────────────────────────────────────────────────────────────────────────────────────────
# ⚠ A MIGRATION REFUSAL, NOT A SETTING. Setting LENS_JWT_SECRET aborts boot with instructions to
# move to ES256. While it was mute that refusal could not fire, so an operator with the stale
# HS256 secret in .env got silence and believed it was in use. Do not set it; it exists to fail.
# ─────────────────────────────────────────────────────────────────────────────────────────────
